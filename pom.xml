<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>E2EAutomation</artifactId>
    <version>1.0-SNAPSHOT</version>


    <!-- ===================================================== -->
    <!-- 🔹 PROJECT PROPERTIES -->
    <!-- Defines Java version and encoding used across project -->
    <!-- ===================================================== -->
    <properties>
        <!-- Ensures all developers use same Java version -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <!-- Prevents encoding issues (especially in reports/logs) -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- default browser -->
        <browser>chrome</browser>
    </properties>


    <!-- ===================================================== -->
    <!-- 🔹 BUILD PLUGINS -->
    <!-- Handles compilation, execution, reporting lifecycle -->
    <!-- ===================================================== -->
    <build>
        <pluginManagement>
            <plugins>

                <!-- Compiles Java source code into bytecode -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                </plugin>

                <!--
                GitHub Action
                     ↓
                mvn clean test
                     ↓
                Maven Surefire Plugin
                     ↓
                ParallelTestNgTestRunner
                     ↓
                Feature Files
                     ↓
                Step Definitions
                                -->

                <!-- Executes test cases (TestNG / Cucumber / JUnit) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.1.2</version>
                    <configuration>
                        <!-- Include test runner class(es) for Maven to discover -->
                        <includes>
                            <include>**/testrunner/ParallelTestNgTestRunner.java</include>
                        </includes>

                        <!-- Parallel execution configuration (Number of thread to run) -->
                        <parallel>methods</parallel>
                        <threadCount>3</threadCount>
                        <reuseForks>true</reuseForks>

                        <!-- JVM arguments for test execution -->
                        <argLine>-Duser.country=US -Duser.language=en</argLine>

                        <!-- System properties for browser configuration -->
                        <systemPropertyVariables>
                            <browser.headless>true</browser.headless>
                            <browser.name>${browser}</browser.name>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>

                <!-- Generates and serves Allure reports -->
                <plugin>
                    <groupId>io.qameta.allure</groupId>
                    <artifactId>allure-maven</artifactId>
                    <version>2.12.0</version>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>


    <!-- ===================================================== -->
    <!-- 🔹 DEPENDENCIES -->
    <!-- Core libraries used in automation framework -->
    <!-- ===================================================== -->
    <dependencies>

        <!-- ================= UI AUTOMATION ================= -->

        <!-- Selenium: Automates browser actions like click, sendKeys -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>4.15.0</version>
        </dependency>


        <!-- ================= BDD - CUCUMBER ================= -->

        <!-- Provides step definition annotations (@Given, @When, @Then) -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>7.14.1</version>
        </dependency>

        <!-- Executes Cucumber tests using JUnit runner -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit</artifactId>
            <version>7.14.1</version>
            <scope>test</scope>
        </dependency>

        <!-- Enables dependency injection between step classes (shared context) -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-picocontainer</artifactId>
            <version>7.14.1</version>
            <scope>test</scope>
        </dependency>


        <!-- ================= TEST EXECUTION ================= -->

        <!-- TestNG: Advanced execution (parallel, retry, grouping) -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.8.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Allows Cucumber scenarios to run using TestNG -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-testng</artifactId>
            <version>7.17.0</version>
        </dependency>


        <!-- ================= LOGGING ================= -->

        <!-- Logging API used in code (logger.info, logger.error) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.20.0</version>
        </dependency>

        <!-- Actual logging engine implementation -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.20.0</version>
        </dependency>

        <!-- Bridges SLF4J logs to Log4j (used by many libraries internally) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j-impl</artifactId>
            <version>2.17.1</version>
        </dependency>


        <!-- ================= REPORTING ================= -->

        <!-- Extent Reports adapter for Cucumber -->
        <dependency>
            <groupId>tech.grasshopper</groupId>
            <artifactId>extentreports-cucumber7-adapter</artifactId>
            <version>1.14.0</version>
        </dependency>

        <!-- Allure integration with Cucumber -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-cucumber7-jvm</artifactId>
            <version>2.29.1</version>
        </dependency>

        <!-- Allure integration with TestNG -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <version>2.25.0</version>
        </dependency>


        <!-- ================= DATA HANDLING ================= -->

        <!-- Apache POI: Handles Excel (.xls) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>5.2.3</version>
        </dependency>

        <!-- Apache POI OOXML: Handles Excel (.xlsx) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.3</version>
        </dependency>


        <!-- ================= UTILITIES ================= -->

        <!-- File operations (copy, delete, read/write files) -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.11.0</version>
        </dependency>

        <!-- String utilities (StringUtils, validation helpers) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.12.0</version>
        </dependency>


        <!-- ================= DRIVER MANAGEMENT ================= -->

        <!-- Automatically downloads and manages browser drivers -->
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>6.1.0</version>
        </dependency>


        <!-- ================= ADVANCED AUTOMATION ================= -->

        <!-- Chrome DevTools integration (network logs, console logs, performance) -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-devtools-v143</artifactId>
            <version>4.39.0</version>
        </dependency>

        <!-- Capture network traffic (API calls, request/response validation) -->
        <dependency>
            <groupId>net.lightbody.bmp</groupId>
            <artifactId>browsermob-core</artifactId>
            <version>2.1.5</version>
        </dependency>


        <!-- ================= SECURITY / OTP ================= -->

        <!-- Generates OTP for automating 2FA login scenarios -->
        <dependency>
            <groupId>com.warrenstrange</groupId>
            <artifactId>googleauth</artifactId>
            <version>1.5.0</version>
        </dependency>


        <!-- ================= JSON HANDLING ================= -->

        <!-- Used for parsing and creating JSON data (API validation) -->
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20240303</version>
        </dependency>


        <!-- ================= EMAIL ================= -->

        <!-- Sends automation reports via email -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-email</artifactId>
            <version>1.6.0</version>
        </dependency>


        <!-- ================= DEPENDENCY FIX ================= -->

        <!-- Required internally by Selenium to avoid NoSuchMethodError -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.0.0-jre</version>
        </dependency>

        <!-- Required for API Automation -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>5.4.0</version>
            <!--            <scope>test</scope>-->
        </dependency>

        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>5.4.0</version>
            <!--            <scope>test</scope>-->
        </dependency>


        <dependency>
            <groupId>com.sikulix</groupId>
            <artifactId>sikulixapi</artifactId>
            <version>2.0.5</version>
        </dependency>

    </dependencies>

</project>

